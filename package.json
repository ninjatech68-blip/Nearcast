{
  "name": "nearcast",
  "main": "expo-router/entry",
  "version": "0.1.1",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/ui": "~57.0.13",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~57.0.16",
    "expo-constants": "~57.0.14",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-chat": "^3.4.0",
    "react-native-keyboard-controller": "^1.22.4",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "supabase": "^2.115.0",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "vitest run",
    "test:components": "jest --runInBand",
    "test:watch": "vitest",
    "bundle:ios": "expo export --platform ios --output-dir dist",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run bundle:ios",
    "db:test": "node scripts/require-db-url.mjs && supabase test db --db-url \"$SUPABASE_DB_URL\"",
    "db:types": "supabase gen types typescript --linked > src/infrastructure/supabase/database.types.ts",
    "preflight:release": "node scripts/preflight-release.mjs",
    "db:push": "supabase db push",
    "build:preview": "npm run preflight:release && eas build --profile preview",
    "build:production": "npm run preflight:release && eas build --profile production"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "resolver": "react-native-worklets/jest/resolver.js"
  },
  "private": true
}
