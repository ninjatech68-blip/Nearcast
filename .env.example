# Leave these blank and the app runs entirely on device, against
# fixtures — every screen works, nothing is shared between phones.
# Fill them in and the same build talks to a real backend: OTP sign-in,
# published casts, and a feed delivered by the server.
#
# For a hosted project (what you want for testing with other people):
#   EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<the anon / publishable key>
# Both are safe on a device — RLS is what protects the data, not the
# key. The service-role key is NOT one of these and never ships.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_ENV=local

# Google Places Autocomplete key for the area picker's address
# suggestions (POI + street level). Restrict the key in Google Cloud
# to the Places API and to your app's bundle id. Without this key the
# area picker falls back to expo-location's neighborhood-only
# geocoder — searches like "social elante" return nothing useful.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

