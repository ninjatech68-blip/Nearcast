# Leave these blank and the app runs entirely on device, against
# fixtures — every screen works, nothing is shared between phones.
# That mode is for the test suites and for working on a screen offline.
# A RELEASE build refuses to start on fixtures, because a tester cannot
# tell invented casts from real ones and the first product rule does not
# make an exception for a forgotten environment file.
# Fill them in and the same build talks to a real backend: OTP sign-in,
# published casts, and a feed delivered by the server.
#
# For a hosted project (what you want for testing with other people):
#   EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<the anon / publishable key>
# Both are safe on a device — RLS is what protects the data, not the
# key. The service-role key is NOT one of these and never ships.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# One of: local | staging | production. Nothing else parses.
# A value outside that set is now a hard stop: the app shows a "build is
# misconfigured" screen naming this variable, in every build. It used to
# be caught and treated as "no backend configured", which silently served
# fixtures with a perfectly good Supabase URL sitting unused beside it.
# An internal build against the hosted project is `staging`.
EXPO_PUBLIC_APP_ENV=local

# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY is gone, deliberately. A release
# build inlines every EXPO_PUBLIC_* value into the bundle, so the key was
# readable by anyone who installed the app, and every area a person typed
# went to Google. On iOS the tier was never reached anyway: the
# nearcast-places native module (MKLocalSearchCompleter) answers first,
# on device, with no key.


# Android only: react-native-maps uses Google Maps there, and without a
# key the area picker renders a blank grey grid — which is now the
# onboarding home step, so it is not optional for an Android build.
# Enable "Maps SDK for Android" in the same Google Cloud project as the
# Places key, restrict the key to the app's package name + signing SHA-1,
# then put it in app.json under android.config.googleMaps.apiKey.
# iOS needs no key: it uses Apple Maps.

# Where a share link points. MUST-020 wants an https link, and that needs
# a domain serving apple-app-site-association from /.well-known/ before a
# link can open the app rather than a browser. Until then leave this blank
# and the share sheet hands out the nearcast:// deep link instead, with
# copy that says it only opens for people who already have the app.
#   EXPO_PUBLIC_SHARE_ORIGIN=https://nearcast.app
EXPO_PUBLIC_SHARE_ORIGIN=
