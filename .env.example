# Hosted Supabase project. Nothing in this project runs locally: a build that
# depends on one machine being reachable is not shippable, and a release build
# inlines these values at bundle time.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
EXPO_PUBLIC_APP_ENV=staging
