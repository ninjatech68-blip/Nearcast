# Local Supabase, started by `npm run db:start`.
#
# The iOS simulator shares the Mac's loopback, so 127.0.0.1 works there. A
# physical device on the same Wi-Fi does not — 127.0.0.1 on the phone is the
# phone. For Expo Go or a dev build on a real device, replace 127.0.0.1 with
# the Mac's LAN IP (e.g. http://192.168.1.42:54321); `ipconfig getifaddr en0`
# prints it. The publishable key is what `npx supabase status -o env` prints as
# ANON_KEY; this app must never carry the service-role key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
EXPO_PUBLIC_APP_ENV=local
# Optional until the share domain exists (human action H-4). Leave unset to
# fall back to nearcast:// scheme links for local testing.
# EXPO_PUBLIC_SHARE_BASE_URL=https://nearcast.app
